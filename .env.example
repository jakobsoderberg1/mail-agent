# Claude API — must be a workspace-scoped key: create it inside a workspace at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# TypeSafe Jev (email classification) — https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# Telegram — create a bot with @BotFather, message it, then run `uv run main.py chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Cloud project that hosts Firestore (locally also run `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=

# Google OAuth — OAuth client (Desktop app) JSON from Google Cloud Console
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Railway only (Cloud Run uses its own service account). Paste the whole key file, plus the
# contents of token.json as GOOGLE_TOKEN_JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_TOKEN_JSON=
